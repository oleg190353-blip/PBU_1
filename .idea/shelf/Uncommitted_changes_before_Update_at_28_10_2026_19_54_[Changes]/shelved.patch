diff --git a/1 Крипто-Валютный конвертор.py b/1 Крипто-Валютный конвертор.py
new file mode 100644
--- /dev/null	(date 1792776870580)
+++ b/1 Крипто-Валютный конвертор.py	(date 1792776870580)
@@ -0,0 +1,161 @@
+from tkinter import Tk, Label, Button, Entry, messagebox as mb
+from tkinter import ttk
+import requests
+
+# --- Списки валют ---
+crypto_codes = {
+    'BTC': 'Биткоин',
+    'ETH': 'Эфириум',
+    'USDT': 'Tether',
+    'BNB': 'Binance Coin',
+    'SOL': 'Solana',
+    'DOGE': 'Dogecoin',
+    'XRP': 'Ripple',
+    'ADA': 'Cardano',
+    'DOT': 'Polkadot',
+    'AVAX': 'Avalanche'
+}
+
+fiat_codes = {
+    'USD': 'Доллар США',
+    'EUR': 'Евро',
+    'RUB': 'Российский рубль',
+    'CNY': 'Китайский юань',
+    'GBP': 'Фунт стерлингов',
+    'JPY': 'Японская йена',
+    'KZT': 'Казахстанский тенге',
+    'UZS': 'Узбекский сум'
+}
+
+all_currencies = {**crypto_codes, **fiat_codes}
+
+def update_base_label(event=None):
+    code = base_combobox.get()
+    name = all_currencies.get(code, code)
+    base_label.config(text=name)
+    root.title(f'Курс обмена ({code})')
+
+def update_target_label(event=None):
+    code = target_combobox.get()
+    name = all_currencies.get(code, code)
+    target_label.config(text=name)
+
+def exchange():
+    # 1. Получаем и проверяем сумму
+    amount_str = amount_entry.get().strip()
+    try:
+        amount = float(amount_str)
+        if amount <= 0:
+            mb.showerror('Ошибка', 'Сумма должна быть больше нуля')
+            return
+    except ValueError:
+        mb.showerror('Ошибка', 'Введите корректное число (например, 100 или 12.5)')
+        return
+
+    # 2. Получаем валюты
+    target_code = target_combobox.get().strip().upper()
+    base_code = base_combobox.get().strip().upper()
+
+    if not target_code or not base_code:
+        mb.showwarning('Внимание', 'Выберите обе валюты')
+        return
+
+    if base_code not in all_currencies or target_code not in all_currencies:
+        mb.showerror('Ошибка', 'Некорректный код валюты')
+        return
+
+    # 3. Запрос к API
+    try:
+        url = f'https://api.coingecko.com/api/v3/simple/price?ids={base_code.lower()}&vs_currencies={target_code.lower()}'
+        resp = requests.get(url, timeout=5)
+        resp.raise_for_status()
+        data = resp.json()
+
+        base_data = data.get(base_code.lower())
+        if not base_data:
+            mb.showerror('Ошибка API', 'Данные по этой валюте не найдены')
+            return
+
+        rate = base_data.get(target_code.lower())
+        if rate is None:
+            mb.showerror('Ошибка', f'Курс {base_code} → {target_code} не найден')
+            return
+
+        # 4. Расчёт
+        result = amount * rate
+
+        base_name = all_currencies[base_code]
+        target_name = all_currencies[target_code]
+
+        # Подбираем точность вывода
+        if target_code == 'JPY':
+            fmt_rate = '.1f'
+            fmt_result = '.1f'
+        elif base_code in crypto_codes:
+            fmt_rate = '.6f'
+            fmt_result = '.6f'
+        else:
+            fmt_rate = '.4f'
+            fmt_result = '.2f'
+
+        # Показываем результат и в popup, и в окне
+        msg = f'Курс: 1 {base_name} = {rate:{fmt_rate}} {target_name}\n' \
+              f'Итого: {amount} {base_name} → {result:{fmt_result}} {target_name}'
+
+        result_label.config(
+            text=msg,
+            foreground='green'
+        )
+        mb.showinfo('Результат конвертации', msg)
+
+    except requests.exceptions.Timeout:
+        mb.showerror('Ошибка', 'Превышено время ожидания ответа от сервера')
+        result_label.config(text='', foreground='black')
+    except requests.exceptions.ConnectionError:
+        mb.showerror('Ошибка', 'Нет соединения с интернетом')
+        result_label.config(text='', foreground='black')
+    except requests.exceptions.HTTPError as e:
+        mb.showerror('Ошибка HTTP', f'Ошибка сервера: {e}')
+        result_label.config(text='', foreground='black')
+    except Exception as e:
+        mb.showerror('Неизвестная ошибка', str(e))
+        result_label.config(text='', foreground='black')
+
+root = Tk()
+root.title('Курс обмена (крипто + фиатные)')
+root.geometry('420x320')
+
+# Базовая валюта
+Label(root, text='Базовая валюта').pack(padx=10, anchor='w')
+base_combobox = ttk.Combobox(root, values=list(all_currencies.keys()), state='readonly')
+base_combobox.pack(pady=3, padx=10, fill='x')
+base_combobox.bind('<<ComboboxSelected>>', update_base_label)
+base_combobox.current(0)
+base_label = ttk.Label(root, font=('', 10, 'italic'))
+base_label.pack(anchor='w', padx=15)
+update_base_label()
+
+# Целевая валюта
+Label(root, text='Целевая валюта').pack(padx=10, anchor='w', pady=(10, 0))
+target_combobox = ttk.Combobox(root, values=list(all_currencies.keys()), state='readonly')
+target_combobox.pack(pady=3, padx=10, fill='x')
+target_combobox.bind('<<ComboboxSelected>>', update_target_label)
+target_combobox.current(1)
+target_label = ttk.Label(root, font=('', 10, 'italic'))
+target_label.pack(anchor='w', padx=15)
+update_target_label()
+
+# Поле суммы
+Label(root, text='Сумма для конвертации').pack(padx=10, anchor='w', pady=(10, 0))
+amount_entry = Entry(root)
+amount_entry.pack(pady=3, padx=10, fill='x')
+amount_entry.insert(0, '100')  # подсказка
+
+# Кнопка
+Button(root, text='Конвертировать', command=exchange).pack(pady=15, padx=10)
+
+# Результат (прямо в окне)
+result_label = Label(root, justify='left', anchor='w')

+from tkinter import Tk, Label, Button, Entry, messagebox as mb
+from tkinter import ttk
+import requests
+
+# --- Словари: тикер -> название и тикер -> ID для API ---
+crypto_codes = {
+    'BTC': {'name': 'Биткоин', 'id': 'bitcoin'},
+    'ETH': {'name': 'Эфириум', 'id': 'ethereum'},
+    'USDT': {'name': 'Tether', 'id': 'tether'},
+    'BNB': {'name': 'Binance Coin', 'id': 'binancecoin'},
+    'SOL': {'name': 'Solana', 'id': 'solana'},
+    'DOGE': {'name': 'Dogecoin', 'id': 'dogecoin'},
+    'XRP': {'name': 'Ripple', 'id': 'ripple'},
+    'ADA': {'name': 'Cardano', 'id': 'cardano'},
+    'DOT': {'name': 'Polkadot', 'id': 'polkadot'},
+    'AVAX': {'name': 'Avalanche', 'id': 'avalanche'}
+}
+
+fiat_codes = {
+    'USD': {'name': 'Доллар США', 'id': 'usd'},
+    'EUR': {'name': 'Евро', 'id': 'eur'},
+    'RUB': {'name': 'Российский рубль', 'id': 'rub'},
+    'CNY': {'name': 'Китайский юань', 'id': 'cny'},
+    'GBP': {'name': 'Фунт стерлингов', 'id': 'gbp'},
+    'JPY': {'name': 'Японская йена', 'id': 'jpy'},
+    'KZT': {'name': 'Казахстанский тенге', 'id': 'kzt'},
+    'UZS': {'name': 'Узбекский сум', 'id': 'uzs'}
+}
+
+all_currencies = {**crypto_codes, **fiat_codes}
+
+
+def update_base_label(event=None):
+    code = base_combobox.get()
+    name = all_currencies.get(code, {}).get('name', code)
+    base_label.config(text=name)
+    root.title(f'Курс обмена ({code})')
+
+
+def update_target_label(event=None):
+    code = target_combobox.get()
+    name = all_currencies.get(code, {}).get('name', code)
+    target_label.config(text=name)
+
+
+def exchange():
+    # 1. Получаем и проверяем сумму
+    amount_str = amount_entry.get().strip()
+    try:
+        amount = float(amount_str)
+        if amount <= 0:
+            mb.showerror('Ошибка', 'Сумма должна быть больше нуля')
+            return
+    except ValueError:
+        mb.showerror('Ошибка', 'Введите корректное число (например, 100 или 12.5)')
+        return
+
+    # 2. Получаем валюты
+    target_code = target_combobox.get().strip().upper()
+    base_code = base_combobox.get().strip().upper()
+
+    if not target_code or not base_code:
+        mb.showwarning('Внимание', 'Выберите обе валюты')
+        return
+
+    base_info = all_currencies.get(base_code)
+    target_info = all_currencies.get(target_code)
+
+    if not base_info or not target_info:
+        mb.showerror('Ошибка', 'Некорректный код валюты')
+        return
+
+    # ВАЖНО: берём правильные ID для API
+    base_id = base_info['id']
+    target_id = target_info['id']
+
+    # 3. Запрос к API
+    url = f'https://api.coingecko.com/api/v3/simple/price?ids={base_id}&vs_currencies={target_id}'
+    headers = {'User-Agent': 'Mozilla/5.0'}
+
+    try:
+        resp = requests.get(url, headers=headers, timeout=10)
+        resp.raise_for_status()
+        data = resp.json()
+
+        # Структура ответа: {"bitcoin": {"usd": 68000}}
+        base_data = data.get(base_id)
+
+        if not base_data:
+            msg = f'Нет данных по валюте {base_code} (API вернул пустой объект)'
+            print(msg)
+            mb.showerror('Ошибка API', msg)
+            result_label.config(text='', foreground='black')
+            return
+
+        rate = base_data.get(target_id)
+        if rate is None:
+            msg = f'Курс {base_code} → {target_id} не найден (API вернул null)'
+            print(msg)
+            mb.showerror('Ошибка', msg)
+            result_label.config(text='', foreground='black')
+            return
+
+        # 4. Расчёт
+        result = amount * rate
+
+        base_name = base_info['name']
+        target_name = target_info['name']
+
+        # Подбираем точность вывода
+        if target_code == 'JPY':
+            fmt_rate = '.1f'
+            fmt_result = '.1f'
+        elif base_code in crypto_codes:
+            fmt_rate = '.2f'  # для крипто обычно хватает 2 знаков, если это не стейблкоины
+            fmt_result = '.2f'
+        else:
+            fmt_rate = '.4f'
+            fmt_result = '.2f'
+
+        msg = f'Курс: 1 {base_name} = {rate:{fmt_rate}} {target_name}\n' \
+              f'Итого: {amount} {base_name} → {result:{fmt_result}} {target_name}'
+
+        print(f"DEBUG: URL={url}, Rate={rate}, Result={result}")
+        result_label.config(text=msg, foreground='green')
+        mb.showinfo('Результат конвертации', msg)
+
+    except requests.exceptions.Timeout:
+        msg = 'Превышено время ожидания ответа от сервера'
+        print(msg)
+        mb.showerror('Ошибка', msg)
+        result_label.config(text='', foreground='black')
+    except requests.exceptions.ConnectionError:
+        msg = 'Нет соединения с интернетом или API недоступен'
+        print(msg)
+        mb.showerror('Ошибка', msg)
+        result_label.config(text='', foreground='black')
+    except requests.exceptions.HTTPError as e:
+        msg = f'Ошибка HTTP: {e}'
+        print(msg)
+        mb.showerror('Ошибка HTTP', msg)
+        result_label.config(text='', foreground='black')
+    except Exception as e:
+        msg = f'Неизвестная ошибка: {e}'
+        print(msg)
+        mb.showerror('Неизвестная ошибка', str(e))
+        result_label.config(text='', foreground='black')
+
+
+root = Tk()
+root.title('Курс обмена (крипто + фиатные)')
+root.geometry('420x340')
+
+Label(root, text='Базовая валюта').pack(padx=10, anchor='w')
+base_combobox = ttk.Combobox(root, values=list(all_currencies.keys()), state='readonly')
+base_combobox.pack(pady=3, padx=10, fill='x')
+base_combobox.bind('<<ComboboxSelected>>', update_base_label)
+base_combobox.current(0)  # BTC
+base_label = ttk.Label(root, font=('', 10, 'italic'))
+base_label.pack(anchor='w', padx=15)
+update_base_label()
+
+Label(root, text='Целевая валюта').pack(padx=10, anchor='w', pady=(10, 0))
+target_combobox = ttk.Combobox(root, values=list(all_currencies.keys()), state='readonly')
+target_combobox.pack(pady=3, padx=10, fill='x')
+target_combobox.bind('<<ComboboxSelected>>', update_target_label)
+target_combobox.current(2)  # RUB
+target_label = ttk.Label(root, font=('', 10, 'italic'))
+target_label.pack(anchor='w', padx=15)
+update_target_label()
+
+Label(root, text='Сумма для конвертации').pack(padx=10, anchor='w', pady=(10, 0))
+amount_entry = Entry(root)
+amount_entry.pack(pady=3, padx=10, fill='x')
+amount_entry.insert(0, '100')
+
+Button(root, text='Конвертировать', command=exchange).pack(pady=15, padx=10)
+
+result_label = Label(root, justify='left', anchor='w', wraplength=400)
+result_label.pack(padx=10, pady=5, fill='both')
+
+root.mainloop()
